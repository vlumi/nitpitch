# App Store Connect API credentials for Scripts/distribute.sh.
# Copy to Scripts/.asc-config (gitignored) and fill in your own IDs.
#
# Generate the key: App Store Connect → Users and Access → Integrations →
# App Store Connect API → generate a key with the App Manager role. Put the
# downloaded .p8 at ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8 — outside
# the repo. Only the two IDs below live here; the private key never does.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
