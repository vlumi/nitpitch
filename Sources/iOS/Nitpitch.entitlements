<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone access needs no entitlement on iOS — it's granted by
	     NSMicrophoneUsageDescription (a plist consent string). -->
	<!-- iCloud Key-Value Storage, for the opt-in sync of instruments,
	     presets and favorites (SyncEngine). The identifier is pinned
	     EXPLICITLY and is identical on iOS + macOS so the two apps share
	     one KVS store — the bundle id is shared for Universal Purchase,
	     and without the explicit pin each platform would derive its own
	     store and never see the other's records (donpa learned this).
	     Off by default: the app writes nothing to it until the user turns
	     the sync switch on. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fi.misaki.nitpitch</string>
	<!-- Universal Links for preset sharing: https://nitpitch.app/t#… opens
	     the app directly. Backed by the static apple-app-site-association on
	     nitpitch.app; the payload rides in the URL fragment (never sent to
	     the server), so the site stays a static host that learns nothing.
	     The custom scheme (nitpitch://) stays registered for old links and
	     as the landing page's open-in-app bridge. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nitpitch.app</string>
	</array>
</dict>
</plist>
