<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store requires App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Audio input: the sandbox blocks every capture device without this, and
	     on the Mac the input is usually a line-in / audio interface (electric
	     guitar or bass through a DI or preamp) rather than the built-in mic.
	     macOS gates them all behind this one entitlement plus the plist
	     consent string. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- iCloud Key-Value Storage, for the opt-in sync of instruments,
	     presets and favorites (SyncEngine). Pinned explicitly and identical
	     to iOS so both platforms share one store — see the iOS entitlements
	     for the why. Off by default: nothing is written until the user
	     turns the sync switch on. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)fi.misaki.nitpitch</string>
	<!-- Still no network entitlement: KVS is written locally and the system
	     daemon (ubd) does the networking outside the sandbox, so the app
	     itself remains unable to make a connection — the sandbox keeps
	     enforcing that rather than merely documenting it. -->
</dict>
</plist>
